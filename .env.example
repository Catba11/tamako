# Secrets template. Copy to `.env.local` (gitignored) and fill in:
#
#     cp .env.example .env.local
#
# The orchestrator and `cargo run` load it with `source .env.local`.
# API keys come from the environment only, never from tamako.toml
# (specs.md Section 13).

# Opencode Go API key (https://opencode.ai/auth). Used as the
# openai-compatible key for the chat/completions models.
OPENAI_API_KEY=

# Only needed if you also use an anthropic-compatible endpoint
# (e.g. MiniMax/Qwen models on Opencode Go, or Anthropic first-party).
# ANTHROPIC_API_KEY=

# Only needed for --live mode against real Telegram.
# TELOXIDE_TOKEN=
