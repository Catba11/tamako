# Secrets template. Copy to `.env.local` (gitignored) and fill in:
#
#     cp .env.example .env.local
#
# The orchestrator and `cargo run` load it with `source .env.local`;
# the LIVE run sources `.env` instead (same keys). API keys come from
# the environment only, never from tamako.toml (specs.md Section 13).

# Opencode Go API key (https://opencode.ai/auth). Used as the
# openai-compatible key for the chat/completions models.
OPENAI_API_KEY=

# Only needed if you also use an anthropic-compatible endpoint
# (e.g. MiniMax/Qwen models on Opencode Go, or Anthropic first-party).
# ANTHROPIC_API_KEY=

# Only needed for --live mode against real Telegram.
# TELOXIDE_TOKEN=

# Live-mode operator overrides (the container env file of
# migration-runbook.md Section 6 is hand-merged from `.env` plus these
# three; they fail SILENT when absent — unset or empty-after-trim both
# count as unset, so this template is the checked-in source of truth
# for the required key set):
# TAMAKO_GATE_LLM_API_KEY=
# TAMAKO_REPLY_LLM_API_KEY=
# TAMAKO_SUMMARY_MODEL=
