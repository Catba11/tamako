# Rust build artifacts
/target
**/*.rs.bk

# Runtime data. One directory per group lives here at runtime
# (store.db, memory.lbug, media/). Never commit group data.
/data

# Local demo and scratch data
/demo-data

# OS noise
.DS_Store

# Local secrets and real configuration. Never commit keys or group ids.
.env
.env.*
!.env.example
tamako.toml
*.swp

# Runtime and benchmark logs. A scrollback export or a redirected
# `tamako --live` log can carry launch commands with API keys and
# bot tokens (2026-09-10 near-miss). Keep logs outside the worktree;
# this rule is the backstop.
*.log
